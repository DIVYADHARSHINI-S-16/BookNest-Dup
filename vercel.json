{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://replace-with-your-render-host.invalid/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
