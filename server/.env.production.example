# Production values for Render. Enter these in the Render dashboard; never commit a real .env.
NODE_ENV=production
# Neon: copy the connection string from the Neon dashboard (must end with ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Upstash: use the rediss:// (TLS) URL
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# Your Vercel URL, no trailing slash (comma-separate extra origins if needed)
CLIENT_ORIGIN=https://your-app.vercel.app
# 32+ chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Fail-safe value: trust only Render's nearest proxy. UNVERIFIED for the Vercel->Render chain; see DEPLOYMENT.md section 5 for the behavioural test.
TRUST_PROXY=1
