DATABASE_URL=postgresql://booknest_user:booknest_pass@localhost:5432/booknest_db
REDIS_URL=redis://localhost:6379
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Auth
# REQUIRED. The server will not start if this is missing, shorter than 32 characters,
# or still a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Set when running behind a reverse proxy / load balancer (number of proxy hops, e.g. 1)
# so the login rate limiter sees real client IPs. Leave unset when not behind a proxy.
# TRUST_PROXY=1

# Tests only (npm run test --workspace=server). Must be a THROWAWAY database whose
# name contains "test" - the tests wipe its tables. Never point this at real data.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/booknest_test
# TEST_REDIS_URL=redis://localhost:6379   # optional; enables the cache-invalidation test

# Public discovery rate limit (POST /api/stores/nearby and GET /api/stores/:storeId/books).
# One shared allowance per client. Invalid or missing values fall back to the defaults.
# DISCOVERY_RATE_LIMIT_MAX=60               # requests per window per client (1-100000)
# DISCOVERY_RATE_LIMIT_WINDOW_SECONDS=60    # window length in seconds (1-3600)
